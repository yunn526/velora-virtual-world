rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /exhibitions/{exhibitionId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.preferredFloor in [2, 3, 4]
        && request.resource.data.preferredZone in ['A', 'B', 'C'];
      allow get, list: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'published';
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.preferredFloor in [2, 3, 4]
        && request.resource.data.preferredZone in ['A', 'B', 'C'];
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
